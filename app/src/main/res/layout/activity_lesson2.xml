<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 2: Division with a Remainder"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="10dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#5D4037"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Imagine you have 500 AMD and want to buy notebooks that cost 40 AMD each. How many notebooks can you buy?\n\nTo find the number of notebooks, we divide 500 by 40. The result shows we can buy 12 notebooks and will have 20 AMD left over (the remainder), which is not enough to buy another notebook."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This operation is called division with a remainder:\n\n•  500 – Dividend\n•  40 – Divisor\n•  12 – Quotient\n•  20 – Remainder"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#E8E0C5"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/tvRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="🚨 Important Rule: The remainder must always be smaller than the divisor."
            android:textColor="#D32F2F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We can verify the division using this relationship:\n500 = 40 × 12 + 20\nor\n(500 - 20) ÷ 40 = 12"
            android:textColor="#212121"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#3E2723"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvFormulaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="General Formula"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFormulaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If dividing a number 'a' by 'b' results in a quotient 'q' and a remainder 'r', it is written as:\n\na = b • q + r   (where 0 ≤ r &lt; b)\n\n• If r = 0, we say that a is divisible by b.\n• If a &lt; b, then the quotient (q) is 0, and the remainder (r) is the number 'a' itself."
                android:textColor="#F5F5DC"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example: All natural numbers that leave a remainder of 3 when divided by 7 take the form 7k + 3 (where k = 0, 1, 2...)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="italic"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E0D5C1"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvProb1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Problem 1"
                android:textColor="#3E2723"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvProb1Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prove that if a number 'a' leaves a remainder of 2 when divided by 5, then the value of the expression 3a + 4 is divisible by 5.\n\nSolution:\nSince 'a' leaves a remainder of 2 when divided by 5, we can write it as a = 5k + 2.\nSubstitute this into the expression:\n3a + 4 = 3(5k + 2) + 4 = 15k + 6 + 4 = 15k + 10\n\nWe can factor this as 5(3k + 2). Since 5 is a factor, the entire result is divisible by 5."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFormsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forms of Integers"
            android:textColor="#3E2723"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvFormsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When dividing 'a' by 'b', the remainder 'r' can be 0, 1, 2, ..., (b-1).\n\n• Case b = 2: Every integer is either even (2q) or odd (2q + 1).\n• Case b = 3: Every integer can be represented as 3q, 3q + 1, or 3q + 2."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E0D5C1"
            android:padding="16dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:id="@+id/tvProb2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Problem 2"
                android:textColor="#3E2723"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvProb2Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prove that the product of three consecutive integers is divisible by 6.\n\nSolution:\nLet the three consecutive integers be n, n+1, n+2. We must prove that n(n+1)(n+2) is divisible by 6.\n\nMethod 1 (By Remainders):\nConsider the possible remainders when n is divided by 6: 0, 1, 2, 3, 4, 5.\n• If n = 6k (remainder 0), the product is clearly divisible by 6.\n• If n = 6k + 4, then n+2 = (6k+4)+2 = 6k+6, which is divisible by 6.\n• If n = 6k + 5, then n+1 = (6k+5)+1 = 6k+6, which is divisible by 6.\n(Other cases are proven using the same logic).\n\nMethod 2 (Divisibility by 2 and 3):\nTo be divisible by 6, a number must be divisible by both 2 and 3.\n1. By 2: Among any two consecutive numbers, one must be even. Therefore, the product is divisible by 2.\n2. By 3: Among any three consecutive numbers, exactly one must be a multiple of 3.\n\nSince the product is divisible by both 2 and 3, it is divisible by 2 × 3 = 6."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START TEST 2"
            android:textStyle="bold"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>