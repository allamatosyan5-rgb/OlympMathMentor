<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_library_pattern"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Subject"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/deep_brown"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnAlgebra"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Algebra"
        app:icon="@drawable/function"
        app:iconGravity="textStart"
        app:iconPadding="16dp"
        app:iconTint="#FFFFFF"
        android:textSize="20sp"
        android:backgroundTint="@color/earth_brown"
        android:layout_marginBottom="15dp"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnGeometry"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Geometry"
        app:icon="@drawable/ruler"
        app:iconGravity="textStart"
        app:iconPadding="16dp"
        app:iconTint="#FFFFFF"
        android:textSize="20sp"
        android:backgroundTint="@color/earth_brown"
        android:layout_marginBottom="15dp"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnNumberTheory"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Number Theory"
        app:icon="@drawable/calculator"
        app:iconGravity="textStart"
        app:iconPadding="16dp"
        app:iconTint="#FFFFFF"
        android:textSize="20sp"
        android:backgroundTint="@color/earth_brown"
        android:layout_marginBottom="15dp"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnCombinatorics"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Combinatorics"
        app:icon="@drawable/dice"
        app:iconGravity="textStart"
        app:iconPadding="16dp"
        app:iconTint="#FFFFFF"
        android:textSize="20sp"
        android:backgroundTint="@color/earth_brown"
        android:layout_marginBottom="15dp"
        android:textColor="#FFFFFF"/>

</LinearLayout>