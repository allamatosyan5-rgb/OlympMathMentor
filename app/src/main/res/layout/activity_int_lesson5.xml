<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intermediate Lesson 5: Advanced Combinatorics"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Permutations &amp; Combinations"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Combinatorics is the mathematics of counting. The two most fundamental concepts are Permutations (order matters) and Combinations (order does NOT matter).\n\n1. Permutations (Arrangements): The number of ways to choose 'r' items from 'n' distinct items AND arrange them is P(n, r) = n! / (n - r)!.\n2. Combinations: The number of ways to simply choose a group of 'r' items from 'n' items is C(n, r) = n! / (r! * (n - r)!).\n\nFor example, selecting a 3-person committee from 10 people uses C(10, 3) = 120. But assigning them roles (President, VP, Secretary) uses P(10, 3) = 720."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. The 'Stars and Bars' Theorem"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stars and Bars is an elegant method for solving problems where we need to distribute identical objects into distinct bins.\n\nTheorem 1: The number of ways to distribute 'n' identical items into 'k' distinct bins (where empty bins are allowed) is equal to finding the non-negative integer solutions to x1 + x2 + ... + xk = n. The formula is C(n + k - 1, k - 1).\n\nTheorem 2: If each bin MUST contain at least one item (positive integer solutions), the formula simplifies to C(n - 1, k - 1)."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Principle of Inclusion-Exclusion (PIE)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When counting the size of the union of multiple sets, simply adding their sizes leads to overcounting the overlapping areas. PIE corrects this by alternatively subtracting and adding the intersections.\n\nFor two sets: |A ∪ B| = |A| + |B| - |A ∩ B|\nFor three sets: |A ∪ B ∪ C| = |A| + |B| + |C| - |A ∩ B| - |A ∩ C| - |B ∩ C| + |A ∩ B ∩ C|.\n\nThis principle is heavily used in number theory and probability."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Circular Permutations &amp; Derangements"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Circular Permutations: When arranging 'n' distinct items in a circle, rotations are considered identical. We fix one item to break the symmetry, making the formula (n - 1)!.\n\nDerangements (D_n): A derangement is a permutation where NO element appears in its original position. D_n = n! * (1 - 1/1! + 1/2! - 1/3! + ... + (-1)^n / n!). For n=3, D_3 = 2."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblem1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad Problem 1:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblem1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How many ways can 10 identical candies be distributed among 3 children?"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: We use Stars and Bars, where n = 10 (candies) and k = 3 (children). Since a child can receive 0 candies, we use the formula: C(10 + 3 - 1, 3 - 1) = C(12, 2).\nC(12, 2) = (12 * 11) / 2 = 66 ways."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvProblem2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad Problem 2:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblem2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How many integers from 1 to 100 are divisible by 2 or 3?"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: Let A be the set of numbers divisible by 2 (|A| = 50), and B the set divisible by 3 (|B| = 33).\nThe intersection A ∩ B is the set of numbers divisible by both 2 and 3 (i.e., 6). |A ∩ B| = 16.\nUsing PIE: |A ∪ B| = 50 + 33 - 16 = 67."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START ADVANCED TEST 5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>