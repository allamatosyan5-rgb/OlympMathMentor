<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_beige"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#3E2723"
        android:weightSum="3"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tabChallenge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Challenge"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"/>

        <TextView
            android:id="@+id/tabLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Leaderboard"
            android:textColor="#A1887F"
            android:textStyle="bold"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"/>

        <TextView
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="History"
            android:textColor="#A1887F"
            android:textStyle="bold"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/layoutSectionChallenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play a Friend"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateRoom"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="CREATE A ROOM"
                            app:backgroundTint="#5D4037"
                            app:cornerRadius="12dp"/>

                        <TextView
                            android:id="@+id/tvRoomCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Code: ------"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#3E2723"
                            android:layout_marginVertical="10dp"
                            android:visibility="gone"/>

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieWaiting"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:visibility="gone"
                            app:lottie_rawRes="@raw/hourglass"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="— OR —"
                            android:textColor="#757575"
                            android:textStyle="bold"
                            android:layout_marginVertical="10dp"/>

                        <EditText
                            android:id="@+id/etJoinCode"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:hint="Enter 6-digit Code"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="6"
                            android:background="@drawable/rounded_card_bg"
                            android:layout_marginBottom="10dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJoinRoom"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="JOIN BATTLE"
                            app:backgroundTint="#3E2723"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSectionLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Players"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:layout_marginBottom="16dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="8dp">
                    <LinearLayout
                        android:id="@+id/layoutLeaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSectionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Match History"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:layout_marginBottom="16dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="8dp">
                    <LinearLayout
                        android:id="@+id/layoutHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </RelativeLayout>
    </ScrollView>
</LinearLayout>