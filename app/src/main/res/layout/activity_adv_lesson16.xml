<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Lesson 16: Cauchy-Schwarz Inequality"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. The Cauchy-Schwarz Inequality"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Cauchy-Schwarz inequality is one of the most widely used inequalities in mathematics. For any two sequences of real numbers (a1, a2, ..., an) and (b1, b2, ..., bn), it states that (a1*b1 + a2*b2 + ... + an*bn)^2 is less than or equal to (a1^2 + a2^2 + ... + an^2) * (b1^2 + b2^2 + ... + bn^2). Equality holds if and only if the two sequences are proportional, meaning a_i / b_i is constant for all i."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Titu's Lemma"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A very powerful form of Cauchy-Schwarz, often called Titu's Lemma (or Engel's form), states that for positive real numbers a_i and b_i, the sum (a_i^2 / b_i) is greater than or equal to (sum a_i)^2 / (sum b_i). This form is specifically useful in Olympiad problems where you need to minimize fractions or sum up terms. It often allows you to simplify extremely complex algebraic expressions with a single stroke."
            android:textSize="16sp"
            android:textColor="#212121"
            android:background="#EFEBE5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Generalizations"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cauchy-Schwarz is not limited to real numbers. It generalizes to complex numbers, vectors in Hilbert space, and even integrals. In the integral form, known as the Bunyakovsky inequality, the sum becomes an integral of the product of two functions. These generalizations show that the underlying logic—the relationship between a projection and the product of norms—is universal across all branches of mathematics."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Olympiad Application"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove that for positive reals a, b, c, the following holds: a^2/b + b^2/c + c^2/a >= a + b + c."
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: We use Titu's Lemma, which is a direct application of Cauchy-Schwarz. The lemma states: Sum(a_i^2 / b_i) >= (Sum a_i)^2 / Sum(b_i). Here, our terms are a^2/b, b^2/c, and c^2/a. Applying Titu's Lemma, the sum is >= (a+b+c)^2 / (b+c+a). Since (a+b+c)^2 / (a+b+c) simplifies to just (a+b+c), the original expression is indeed greater than or equal to (a+b+c). Equality holds when a/b = b/c = c/a, which implies a = b = c. Proof complete."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="START ADVANCED TEST 16"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>