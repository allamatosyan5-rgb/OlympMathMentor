<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intermediate Lesson 19: Set Theory Foundations"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- SECTION 1 -->
        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Basic Concepts &amp; Subsets"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A 'Set' is a well-defined collection of distinct objects, called elements. \n• Membership: If 'x' is an element of set A, we write x ∈ A. \n• Subsets: Set A is a subset of B (A ⊆ B) if every element of A is also in B. \n• Power Set: The set of all possible subsets of A is called its Power Set P(A). If A has 'n' elements, its Power Set has exactly 2^n elements. This includes the empty set (∅) and the set A itself."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 2 -->
        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Operations on Sets"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fundamental operations allow us to construct new sets:\n1. Union (A ∪ B): Elements in A, OR B, or both.\n2. Intersection (A ∩ B): Elements in BOTH A and B.\n3. Difference (A \ B): Elements in A that are NOT in B.\n4. Complement (Aᶜ): Elements in the Universal set (U) that are NOT in A.\nDe Morgan's Laws for Sets:\n• (A ∪ B)ᶜ = Aᶜ ∩ Bᶜ\n• (A ∩ B)ᶜ = Aᶜ ∪ Bᶜ"
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 3 -->
        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Cartesian Product"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Cartesian Product of two sets A and B (A × B) is the set of all ordered pairs (a, b) where a ∈ A and b ∈ B. \nFor example, if A = {1, 2} and B = {x, y}, then A × B = {(1,x), (1,y), (2,x), (2,y)}. \nThe number of elements in A × B is |A| * |B|. This concept is the foundation for defining functions and relations in mathematics."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 4 -->
        <TextView
            android:id="@+id/tvSubtitle4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Cardinality &amp; Infinity"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cardinality |A| refers to the number of elements in a set. \n• Countable Infinity: Sets like Natural numbers (N) or Integers (Z) have the same cardinality, denoted by aleph-null (ℵ₀). \n• Uncountable Infinity: The set of Real numbers (R) is 'larger' than the set of integers. \nCantor's Theorem proves that for any set, the Power Set always has a strictly greater cardinality than the set itself, meaning there are infinitely many sizes of infinity!"
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <!-- PROBLEM 1 -->
        <TextView
            android:id="@+id/tvProblem1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad Problem 1: Power Sets"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblem1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A set S has 10 elements. How many subsets of S contain at least 2 elements?"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: The total number of subsets of a set with 10 elements is 2^10 = 1024. \nWe need to subtract the subsets that have FEWER than 2 elements:\n1. The empty set (0 elements): 1 subset.\n2. Subsets with exactly 1 element: There are 10 such subsets.\nTotal to subtract = 1 + 10 = 11. \nResult = 1024 - 11 = 1013."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START ADVANCED TEST 19"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>