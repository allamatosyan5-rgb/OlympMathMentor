<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Lesson 7: Lifting The Exponent Lemma and Pell's Equation"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. The p-adic Valuation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In advanced number theory, we often need to find the highest power of a prime p that divides a given number n. This is called the p-adic valuation of n, denoted as v_p(n). For example, v_2(24) equals 3, because 24 is 8 times 3, and 8 is 2 to the power of 3. Understanding how primes divide large numbers is the absolute key to solving complex Diophantine equations."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Lifting The Exponent Lemma (LTE)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LTE is a massively powerful tool. It states that if p is an odd prime, p divides (x minus y), but p does NOT divide x or y, then the highest power of p dividing (x to the n minus y to the n) is simply the sum of two valuations: v_p(x-y) plus v_p(n). This brilliant lemma turns monstrous exponential equations into very simple addition! Note that for p=2, the formula requires extra conditions."
            android:textSize="16sp"
            android:textColor="#212121"
            android:background="#EFEBE5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Pell's Equation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pell's Equation is a beautiful Diophantine equation of the form: x squared minus d times y squared equals 1, where d is a positive integer that is not a perfect square. Its magic lies in the fact that if you can find just one non-trivial solution, known as the fundamental solution, you can generate infinitely many other solutions. You do this by expanding the expression (x1 + y1 times square root of d) to the power of n."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Olympiad Application"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find the highest power of 3 that completely divides the expression: 17 to the power of 81 minus 8 to the power of 81."
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: Let us use the Lifting The Exponent Lemma. Our prime is p=3. Here x=17, y=8, and n=81. Let's check the conditions carefully. First, p is odd, since 3 is odd. Second, does 3 divide x-y? 17-8 = 9, and 3 divides 9 perfectly, so yes. Finally, does 3 divide 17 or 8? No. The conditions are perfectly met. According to LTE, v_3(17^81 - 8^81) is equal to v_3(17-8) + v_3(81). We know 17-8=9, which is 3 squared, so v_3(9)=2. Also, 81 is 3 to the power of 4, so v_3(81)=4. Adding them together gives 2 + 4 = 6. Therefore, the highest power of 3 dividing the expression is 3 to the power of 6. Proof complete."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="START ADVANCED TEST 7"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>