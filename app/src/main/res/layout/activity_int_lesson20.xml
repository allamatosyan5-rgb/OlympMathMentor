<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intermediate Lesson 20: Theory of Functions"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- SECTION 1 -->
        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Domain, Codomain, and Range"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A function 'f' is a rule that assigns each element in set A (Domain) to exactly ONE element in set B (Codomain). \n• Domain: The set of all possible input values. \n• Codomain: The set where outputs are 'allowed' to fall. \n• Range: The actual set of values that the function outputs. The range is always a subset of the codomain."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 2 -->
        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Types of Functions (Mapping)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Understanding how a function maps elements is vital for Olympiad problems:\n1. Injective (One-to-One): If f(x) = f(y), then x must equal y. No two inputs share the same output.\n2. Surjective (Onto): Every element in the codomain has at least one input mapping to it. Range = Codomain.\n3. Bijective: Both injective and surjective. These functions have an 'Inverse' f⁻¹(x) that perfectly reverses the rule."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 3 -->
        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Composite &amp; Inverse Functions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A Composite function, written as (f ∘ g)(x) or f(g(x)), means you apply the rule 'g' first and then apply 'f' to that result. \nProperty: (f ∘ g) is NOT generally the same as (g ∘ f). \nAn Inverse function f⁻¹(x) exists if and only if f is bijective. The identity property is: f(f⁻¹(x)) = x and f⁻¹(f(x)) = x."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 4 -->
        <TextView
            android:id="@+id/tvSubtitle4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Cauchy's Functional Equation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Functional equations ask you to find the function itself rather than a single number. \nThe most famous is Cauchy's Equation: f(x + y) = f(x) + f(y).\nIf this holds for all real numbers and f is continuous (or monotonic), then the only solution is f(x) = cx for some constant c. \nTechniques: Plug in x=0, y=0, or let y = -x to find fixed points and build the function's character step-by-step."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <!-- PROBLEM 1 -->
        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad Problem:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find the inverse of the function f(x) = (2x + 3) / (x - 5) for x ≠ 5."
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: Let y = (2x + 3) / (x - 5). Now, solve for x in terms of y:\ny(x - 5) = 2x + 3\nyx - 5y = 2x + 3\nyx - 2x = 5y + 3\nx(y - 2) = 5y + 3\nx = (5y + 3) / (y - 2)\nTherefore, the inverse function is f⁻¹(x) = (5x + 3) / (x - 2)."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START FINAL MODULE TEST 20"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>