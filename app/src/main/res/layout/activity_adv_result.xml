<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F5DC"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvFinalResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exam Result"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvScoreDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#5D4037"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnGetCertificate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="GET CERTIFICATE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnBackToAdvanced"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="BACK TO LESSONS"
        android:textSize="16sp"
        android:backgroundTint="#5D4037"
        android:textColor="#FFFFFF"/>

</LinearLayout>