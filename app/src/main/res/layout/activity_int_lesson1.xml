<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_header_bg"
            android:padding="24dp"
            android:elevation="6dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advanced Number Theory"
                android:textColor="#8B4513"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:textAllCaps="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lesson 1: Extreme Divisibility"
                android:textColor="#3E2723"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to the true Olympiad arena. Basic division rules won't save you here. We will study the structural DNA of integers, powerful algebraic manipulations, and advanced theorems that solve IMO-level problems."
            android:textColor="#4E342E"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp"
            android:textStyle="italic"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗝️ 1. Bézout's Identity"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let 'a' and 'b' be integers with greatest common divisor d = GCD(a, b). Then, there exist integers x and y (called Bézout coefficients) such that:"
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="a·x + b·y = d"
                    android:textColor="#D32F2F"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFEBEE"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Why is this mind-blowing?\nIf a and b are coprime (GCD = 1), you can ALWAYS find integers x and y such that ax + by = 1. This is the foundation of modular inverses and solving linear Diophantine equations."
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚔️ 2. Algebraic Divisibility Tricks"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="In Olympiads, you frequently need to divide polynomials. Memorize these golden identities for any integer n:"
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E8F5E9"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rule 1: (a - b) ALWAYS divides (aⁿ - bⁿ)"
                        android:textColor="#2E7D32"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rule 2: If n is ODD, (a + b) ALWAYS divides (aⁿ + bⁿ)"
                        android:textColor="#2E7D32"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Olympiad Example:\nProve that 7 divides (3^105 + 4^105).\n\nSolution: Since 105 is an odd number, we can use Rule 2. Let a=3, b=4. Then (3+4) must divide (3^105 + 4^105). Since 3+4 = 7, the proof is complete in one second!"
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:background="#FFF3E0"
                    android:padding="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧮 3. The Power of τ(n) and σ(n)"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let the prime factorization of n be:\nn = p₁^a₁ × p₂^a₂ × ... × pₖ^aₖ\n\nτ(n) (Tau) is the TOTAL NUMBER of divisors:\nτ(n) = (a₁+1)(a₂+1)...(aₖ+1)\n\nσ(n) (Sigma) is the SUM of all divisors:\nσ(n) = [ (p₁^(a₁+1) - 1)/(p₁ - 1) ] × ... "
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:background="#EFEBE5"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hard Question Analysis:\n'Find all integers n such that τ(n) = 3.'\nSince τ(n) = (a₁+1)(a₂+1)... = 3, and 3 is prime, there can only be ONE prime factor, and its exponent must be 2 (since 2+1=3). Thus, n MUST be the square of a prime number (like 4, 9, 25, 49...)."
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭 4. Sophie Germain Identity"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="At first glance, an expression like a⁴ + 4b⁴ looks impossible to factor. But Sophie Germain gave us this masterpiece by adding and subtracting 4a²b²:"
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="a⁴ + 4b⁴ = \n(a² - 2ab + 2b²) × (a² + 2ab + 2b²)"
                    android:textColor="#1565C0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#E3F2FD"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Olympiad Trick:\nIs n⁴ + 4 ever a prime number? Let a=n and b=1. Using the identity, n⁴ + 4 = (n²-2n+2)(n²+2n+2). For this to be prime, the smaller bracket must equal 1. Solving n²-2n+2 = 1 gives n=1. So, n⁴ + 4 is prime ONLY when n=1 (which gives 5). For all other n, it's composite!"
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:background="#FFF9C4"
                    android:padding="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ 5. Legendre's Formula"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How do you find the highest power of a prime 'p' that divides n! (n factorial)? Legendre’s formula calculates this instantly. We denote this highest power as v_p(n!)."
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v_p(n!) = ⌊n/p⌋ + ⌊n/p²⌋ + ⌊n/p³⌋ + ..."
                    android:textColor="#C2185B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FCE4EC"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Example: How many trailing zeros does 100! have?\nTrailing zeros are created by pairs of 2 and 5. Since there are always more 2s than 5s, we just need to count the 5s using Legendre:\n⌊100/5⌋ + ⌊100/25⌋ + ⌊100/125⌋...\n= 20 + 4 + 0 = 24 trailing zeros."
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☢️ 6. Lifting The Exponent (LTE)"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This is the absolute endgame weapon for Olympiad Number Theory. Let p be an ODD prime, and x, y be integers such that p divides (x-y), but p DOES NOT divide x and does not divide y. Then for any integer n:"
                    android:textColor="#4E342E"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v_p(xⁿ - yⁿ) = v_p(x - y) + v_p(n)"
                    android:textColor="#F57C00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFF3E0"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What does this mean visually? The number of times the prime 'p' divides (xⁿ - yⁿ) is exactly equal to the times it divides (x - y) PLUS the times it divides the exponent 'n'.\n\nIf you see large exponents in a divisibility problem, LTE is almost always the intended path to victory."
                    android:textColor="#5D4037"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take a deep breath. You have just absorbed mathematical tools that most students never see. Prove your worth in the test below."
            android:textColor="#8D6E63"
            android:textSize="15sp"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGoToTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initiate Advanced Test →"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#8B4513"
            android:textColor="@color/white"
            android:padding="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>
</ScrollView>