<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 11: Parity"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odd and Even Dynamics, Invariants, and Colorings"
            android:textSize="16sp"
            android:textColor="#5D4037"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. The Basics of Parity"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parity refers to whether an integer is Even (divisible by 2) or Odd (not divisible by 2). While this seems simple, it is one of the most powerful tools in Olympiad mathematics for proving whether a certain state is possible or impossible."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec1RuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ARITHMETIC RULES:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSec1Rules1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Addition and Subtraction:\n• Even ± Even = Even\n• Odd ± Odd = Even\n• Even ± Odd = Odd"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:background="#C9ADA3"
            android:padding="20dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec1Rules2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multiplication:\n• Even × Any Number = Even\n• Odd × Odd = Odd\n\n(If a product of many numbers is Odd, it means EVERY SINGLE number in the product MUST be Odd!)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:background="#BBDEFB"
            android:padding="20dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Parity of a Sum"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The parity of a sum of many numbers depends EXCLUSIVELY on the quantity of Odd numbers in the sum. The Even numbers do not affect the parity at all."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec2Rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="► Rule 1: The sum of an EVEN number of Odds is EVEN. (e.g., 3 + 5 = 8; or 1 + 3 + 5 + 7 = 16)\n\n► Rule 2: The sum of an ODD number of Odds is ODD. (e.g., 3 + 5 + 7 = 15)"
            android:textColor="#212121"
            android:textSize="16sp"
            android:background="#FCE4EC"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. The Concept of Invariant (Անփոփոխ)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In many logic puzzles, objects are transformed step by step. An 'Invariant' is a property that NEVER changes during these steps. Most of the time, this invariant is Parity."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example: There are 7 glasses upside down. You are allowed to flip exactly 2 glasses at a time. Can you make all glasses face up?\n\nSolution: When you flip 2 glasses, the number of upside-down glasses can change by +2, -2, or 0. Notice that all these changes are EVEN numbers. Therefore, the parity of upside-down glasses is an INVARIANT! It starts as 7 (Odd). It can NEVER reach 0 (Even). It is impossible."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:background="#C8E6C9"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvMasterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masterclass: Advanced Problem Solving"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 1: The Magic Apples"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb1Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: In a basket, there are 13 Red apples and 14 Green apples. A wizard tells you:\n- If you eat 2 apples of the SAME color, he gives you 1 Green apple.\n- If you eat 2 apples of DIFFERENT colors, he gives you 1 Red apple.\nYou eat apples until only 1 apple is left. What color is it?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb1S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Let's track the RED apples. We start with 13 (Odd)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Scenario A - You eat 2 Red apples. You get 1 Green. The number of Red apples changes by -2."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Scenario B - You eat 2 Green apples. You get 1 Green. The number of Red apples changes by 0."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: Scenario C - You eat 1 Red and 1 Green. You get 1 Red. You lost 1 Red, but gained 1 Red. The number of Red apples changes by 0."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 5: Notice the pattern! The number of Red apples only changes by -2 or 0. This means the PARITY of Red apples is Invariant."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: Since we started with an Odd number of Red apples (13), we must always have an Odd number. When 1 apple is left, it CANNOT be 0 Red apples (because 0 is Even). It MUST be 1 Red apple!"
                android:textColor="#B71C1C"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 2: The Chessboard and Dominoes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb2Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: A standard 8x8 chessboard has 64 squares. We cut off two diagonally opposite corners (e.g., top-left and bottom-right). We have 31 dominoes, each covering exactly 2 adjacent squares. Can we cover the remaining 62 squares perfectly?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb2S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Color Parity. A chessboard is colored alternately Black and White. Total: 32 Black, 32 White."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: A domino covers EXACTLY 2 adjacent squares. One will always be Black, and one will always be White."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: This means 31 dominoes MUST cover exactly 31 Black squares and 31 White squares."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: Now look at the missing corners. Diagonally opposite corners on a chessboard are ALWAYS the SAME color. Let's say they are both White."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 5: The remaining board has 32 Black squares, but only 30 White squares."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: Since we need to cover 32 Black and 30 White squares, but our dominoes require equal amounts (31 and 31), it is absolutely IMPOSSIBLE."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest11"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="TAKE TEST 11"
            android:textStyle="bold"
            android:textSize="22sp"
            app:backgroundTint="#FFCDD2"
            android:textColor="#3E2723"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>