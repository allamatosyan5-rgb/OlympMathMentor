<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 1: Natural Numbers"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Even and Odd Natural Numbers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numbers used for counting are called natural numbers. They are 1; 2; 3; ...; n; ... The set of natural numbers is denoted by the letter N. The set of natural numbers is infinite."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0D5C1"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvExamples1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Even natural numbers: 2, 4, 6, ..., 2n\n• Odd natural numbers: 1, 3, 5, ..., 2n-1"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#3E2723"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvProperties1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Properties:\n• The sum of even natural numbers is even.\n• The sum of an even quantity of odd numbers is even.\n• The sum of an odd quantity of odd numbers is odd.\n• The product of even natural numbers is even.\n• The product of odd natural numbers is odd."
            android:textSize="16sp"
            android:textColor="#212121"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblem1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem 1:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>
        <TextView
            android:id="@+id/tvProblem1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove that the equation 2x + 4y = 2003 has no solution in the set of natural numbers."
            android:textSize="16sp"
            android:textColor="#212121"/>
        <TextView
            android:id="@+id/tvSolution1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: If x, y are natural, then 2x and 4y are even. Their sum is even, which cannot be 2003 (odd). No solution."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D2B48C"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Consecutive Natural Numbers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Natural numbers that differ from each other by 1 are called consecutive numbers.\nExample: n; n+1; n+2; ..."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvProperties2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Properties of consecutive numbers:\na) The sum of two consecutive numbers is odd: n + (n+1) = 2n + 1.\nb) The product of two or more consecutive numbers is even.\nc) The product of two consecutive numbers ends in 0, 2, or 6.\nd) The sum of two consecutive odd numbers is divisible by 4."
            android:textSize="16sp"
            android:textColor="#212121"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START TEST 1"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>