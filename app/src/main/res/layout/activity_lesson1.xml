<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 1: Natural Numbers"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Even and Odd Natural Numbers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numbers used for counting are called natural numbers. They are 1; 2; 3; ...; n; ... The set of natural numbers is denoted by the letter N. The set of natural numbers is infinite."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0D5C1"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Even natural numbers: 2, 4, 6, ..., 2n\n• Odd natural numbers: 1, 3, 5, ..., 2n-1"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#3E2723"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Properties:\n• The sum of even natural numbers is even.\n• The sum of an even quantity of odd numbers is even.\n• The sum of an odd quantity of odd numbers is odd.\n• The product of even natural numbers is even.\n• The product of odd natural numbers is odd."
            android:textSize="16sp"
            android:textColor="#212121"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem 1:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove that the equation 2x + 4y = 2003 has no solution in the set of natural numbers."
            android:textSize="16sp"
            android:textColor="#212121"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: If x, y are natural, then 2x and 4y are even. Their sum is even, which cannot be 2003 (odd). No solution."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem 2:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Is it possible to place odd numbers from 1 to 99 in a 5x5 grid such that the sum in any direction is 50?"
            android:textSize="16sp"
            android:textColor="#212121"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: No, because the sum of any 5 natural odd numbers is odd (and 50 is even)."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D2B48C"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Consecutive Natural Numbers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Natural numbers that differ from each other by 1 are called consecutive numbers.\nExample: n; n+1; n+2; ..."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Properties of consecutive numbers:\na) The sum of two consecutive numbers is odd: n + (n+1) = 2n + 1.\nb) The product of two or more consecutive numbers is even.\nc) The product of two consecutive numbers ends in 0, 2, or 6.\nd) The sum of two consecutive odd numbers is divisible by 4."
            android:textSize="16sp"
            android:textColor="#212121"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem 1:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove that (x+1)(x+2) + (y+3)(y+4) = 2001 has no natural number solutions."
            android:textSize="16sp"
            android:textColor="#212121"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: The products (x+1)(x+2) and (y+3)(y+4) are products of consecutive numbers, so they are even. Their sum is even, but 2001 is odd. No solution."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem 2:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Does x(x+1) + (y+2000)(y+2001) = 5•15•...•95 have a solution?"
            android:textSize="16sp"
            android:textColor="#212121"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: The left side is a sum of two even products (ending in 0, 2, or 6), so it ends in 0, 2, 4, 6, or 8. The right side ends in 5. No solution."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START TEST"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>