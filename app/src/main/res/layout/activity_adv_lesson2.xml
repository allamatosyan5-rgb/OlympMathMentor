<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Lesson 2: Algebraic Inequalities 1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. The Trivial Inequality"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The most fundamental inequality in algebra is the 'Trivial Inequality'. For any real number x, the square of x is always non-negative: x^2 ≥ 0. Equality holds if and only if x = 0. While simple, expanding forms like (a - b)^2 ≥ 0 leads to a^2 + b^2 ≥ 2ab, which is the cornerstone of many complex proofs."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. AM-GM Inequality"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Arithmetic Mean - Geometric Mean (AM-GM) inequality is the most frequently used inequality in Math Olympiads. It states that for any non-negative real numbers a and b:\n\n(a + b) / 2 ≥ √(ab)\n\nCrucially, equality holds IF AND ONLY IF a = b. This can be extended to 'n' variables: the sum of 'n' non-negative numbers divided by 'n' is always greater than or equal to their n-th root."
            android:textSize="16sp"
            android:textColor="#212121"
            android:background="#EFEBE5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Cauchy-Schwarz Inequality"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlike AM-GM, Cauchy-Schwarz works for ALL real numbers (including negative ones). In its simplest 2D form, for any real numbers a, b, x, y:\n\n(a^2 + b^2)(x^2 + y^2) ≥ (ax + by)^2\n\nEquality holds when the sequences are proportional, meaning a/x = b/y."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad Application"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove that for any positive real numbers x and y, the expression (x/y + y/x) is always greater than or equal to 2."
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: Let a = x/y and b = y/x. Since x, y > 0, a and b are positive. Apply AM-GM: (a + b) / 2 ≥ √(a * b). Substitute back: (x/y + y/x) / 2 ≥ √(x/y * y/x). Notice that the product inside the root cancels out to 1! So, (x/y + y/x) / 2 ≥ 1. Multiplying both sides by 2 gives x/y + y/x ≥ 2. Proof complete!"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="START ADVANCED TEST 2"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>