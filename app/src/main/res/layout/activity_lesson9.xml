<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 9: Boats &amp; Streams"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Currents, Relative Speed, and The Hat Paradox"
            android:textSize="16sp"
            android:textColor="#5D4037"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. The Four Essential Speeds"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In river problems, we are dealing with two independent moving objects: the boat itself, and the water it travels on. You must clearly distinguish between four types of speed."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E1BEE7"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvSec1Bul1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Speed of Boat in Still Water (V_b): The pure power of the boat's engine on a calm lake."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSec1Bul2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Speed of Current/Stream (V_s): How fast the river flows. A raft floats exactly at this speed."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSec1Bul3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Downstream Speed (V_down): Moving WITH the river. \nFormula: V_down = V_b + V_s"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSec1Bul4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Upstream Speed (V_up): Moving AGAINST the river. \nFormula: V_up = V_b - V_s"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#D32F2F" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Reverse Engineering Formulas"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec2Text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Olympiad problems often give you the Downstream and Upstream speeds, asking you to find the boat's pure speed or the river's speed. These two formulas are lifesavers:"
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec2Text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="► V_b = (V_down + V_up) / 2\n(The Boat is the average of the two speeds)\n\n► V_s = (V_down - V_up) / 2\n(The Stream is half the difference)"
            android:textColor="#212121"
            android:textSize="16sp"
            android:background="#C8E6C9"
            android:padding="20dp"
            android:textStyle="bold"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. The Concept of a Raft"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A raft (or a piece of wood, a lost hat) has NO engine. It cannot move by itself. Therefore, a raft travels exactly at the speed of the current (V_s)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relative Speed Secret:\nIf a boat is chasing a raft downstream, the relative speed is:\nV_down - V_raft = (V_b + V_s) - V_s = V_b.\n\nIncredibly, the river's current cancels out! The boat catches the raft as if they were both in a stationary lake."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:background="#FFE0B2"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvMasterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masterclass: Olympiad Problems"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 1: The Basic Round Trip"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00796B"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb1Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: A boat goes 48 km downstream in 3 hours, and returns upstream in 4 hours. Find the speed of the boat in still water and the speed of the current."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb1S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Calculate V_down. \nV_down = Distance / Time = 48 / 3 = 16 km/h."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Calculate V_up. \nV_up = Distance / Time = 48 / 4 = 12 km/h."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Use the reverse formulas. \nBoat (V_b) = (16 + 12) / 2 = 14 km/h."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: Find the stream speed. \nStream (V_s) = (16 - 12) / 2 = 2 km/h."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: Boat is 14 km/h, Stream is 2 km/h."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 2: Setting up Equations"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00796B"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb2Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: A boat travels 36 km downstream and 36 km upstream. The total journey takes 5 hours. If the river flows at 3 km/h, what is the boat's speed in still water?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb2S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Let V_b be 'x'. \nDownstream speed = x + 3. \nUpstream speed = x - 3."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Total Time = Time Down + Time Up = 5. \n(36 / (x + 3)) + (36 / (x - 3)) = 5"
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: This leads to a quadratic equation, but in Olympiads, we check obvious integers. Let's try x = 15."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: Check x = 15. \nDown: 36 / 18 = 2 hours. \nUp: 36 / 12 = 3 hours. \nTotal = 2 + 3 = 5 hours. It matches perfectly!"
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The boat's speed is 15 km/h."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFCDD2"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb3Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Legendary Hat Paradox"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb3Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: A man's hat falls into the river. The boat continues downstream for 10 minutes before he realizes it. He turns back immediately and catches the hat 1 km from where it originally fell. Find the river's speed."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb3S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Frame of Reference Trick. \nPretend the river is a moving carpet. Both the hat and the boat are on this carpet. Relative to the carpet (the water), the hat is standing completely still!"
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb3S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: If you walk away from a stationary hat for 10 minutes at a certain speed, it will take you exactly 10 minutes to walk back to it at that same speed."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb3S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: So, the boat takes 10 mins back. Total time the hat was in the water = 10 + 10 = 20 minutes (which is 1/3 of an hour)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb3S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: The hat floated 1 km in 1/3 hour. \nSpeed = Distance / Time \nSpeed = 1 / (1/3) = 3 km/h."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb3Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The river flows at 3 km/h. Brilliant!"
                android:textColor="#B71C1C"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest9"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="TAKE TEST 9"
            android:textStyle="bold"
            android:textSize="22sp"
            app:backgroundTint="#C5CAE9"
            android:textColor="#3E2723"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>