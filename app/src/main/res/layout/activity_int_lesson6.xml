<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intermediate Lesson 6: Fascinating Word Problems"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- SECTION 1 -->
        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. The Art of Translation (Algebraic Models)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solving word problems is essentially translating English (or Armenian) into the language of Algebra. The most crucial step is defining your variables accurately.\n• 'Is', 'Yields', 'Results in' translate to '='\n• 'Of' translates to multiplication (e.g., 20% of x is 0.2x).\n• In age problems, always define variables based on the CURRENT age. If a father is 'x' and son is 'y', their ages 'n' years ago were (x - n) and (y - n)."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 2 -->
        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Motion &amp; Relative Speed"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The fundamental formula for motion is: Distance = Rate × Time (D = R × T).\nIn Olympiads, you often encounter Relative Speed:\n• Approaching each other: Speeds are ADDED (R1 + R2).\n• Chasing (same direction): Speeds are SUBTRACTED (R1 - R2).\nFor problems involving boats on a river: Speed Downstream = Boat + Current, Speed Upstream = Boat - Current."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 3 -->
        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Work and Rate Problems"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When people or machines work together, you NEVER add their times. You add their RATES.\nIf Person A can finish a job in 'a' hours, their rate is 1/a of the job per hour.\nIf Person B finishes it in 'b' hours, their rate is 1/b per hour.\nWorking together, their combined rate is (1/a + 1/b). The total time 'T' to finish the job together is found by solving: 1/a + 1/b = 1/T."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION 4 -->
        <TextView
            android:id="@+id/tvSubtitle4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Mixtures &amp; Concentrations"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mixture problems rely on the conservation of mass. The amount of pure substance in the first solution plus the pure substance in the second must equal the pure substance in the final mixture.\nFormula: C1 * V1 + C2 * V2 = C_final * (V1 + V2)\n(Where C is concentration percentage and V is volume)."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <!-- PROBLEM 1 -->
        <TextView
            android:id="@+id/tvProblem1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classic Logic Problem:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblem1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A snail is at the bottom of a 20-meter deep well. Every day it climbs up 5 meters, but at night it slips down 4 meters. How many days will it take for the snail to reach the top of the well?"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: The net progress per day is 5 - 4 = 1 meter. However, on the final day, once the snail reaches the top, it does not slip back down. \nFor the first 15 days, it climbs 15 meters (1m/day). \nOn the 16th day, starting from 15 meters, it climbs 5 meters, reaching exactly 20 meters and escaping the well! So the answer is 16 days, not 20."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- PROBLEM 2 -->
        <TextView
            android:id="@+id/tvProblem2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            text="Olympiad Work Problem:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblem2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pipe A can fill a tank in 6 hours. Pipe B can fill it in 8 hours. Pipe C can EMPTY the full tank in 12 hours. If all three pipes are opened simultaneously, how long will it take to fill the tank?"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: We convert times into rates. \nRate of A = 1/6 (fills 1/6 per hour). \nRate of B = 1/8. \nRate of C = -1/12 (negative because it empties). \nTotal Rate = 1/6 + 1/8 - 1/12. \nThe common denominator is 24. \n(4/24) + (3/24) - (2/24) = 5/24. \nSo, the pipes fill 5/24 of the tank per hour. The total time T is the inverse of the rate: T = 24 / 5 = 4.8 hours."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START ADVANCED TEST 6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>