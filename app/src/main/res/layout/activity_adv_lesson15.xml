<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Lesson 15: Euler's and Fermat's Theorems"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Fermat's Little Theorem"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fermat's Little Theorem is a cornerstone of Number Theory. It states that if p is a prime number, then for any integer a not divisible by p, a raised to the power of (p-1) is congruent to 1 modulo p. This theorem is an incredibly powerful tool because it allows us to reduce massive exponentiation problems to very simple calculations. It is a special case of the more general Euler's Theorem."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Euler's Totient Function and Theorem"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Euler's Totient Function, phi(n), counts how many integers between 1 and n are coprime to n. Euler's Theorem generalizes Fermat's Little Theorem: for any integer a coprime to n, a raised to the power of phi(n) is congruent to 1 modulo n. This is the foundation of the RSA algorithm, which protects almost all internet communications today. By knowing phi(n), we can simplify virtually any power in modular arithmetic."
            android:textSize="16sp"
            android:textColor="#212121"
            android:background="#EFEBE5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Multiplicative Nature"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvContent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A key property of phi(n) is that it is multiplicative. If you have two coprime numbers m and n, then phi(m*n) equals phi(m) times phi(n). For a prime power p to the k, the formula is phi(p^k) = p^k - p^(k-1). This allows us to calculate phi(n) for any number simply by looking at its prime factorization. These properties make modular exponentiation extremely fast and efficient, which is a life-saver in competition mathematics."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D2B48C"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced Olympiad Application"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/tvProblemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find the remainder when 3 to the power of 100 is divided by 7."
            android:textSize="16sp"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvSolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solution: We want to find 3^100 mod 7. Since 7 is a prime number and 3 is not divisible by 7, we can use Fermat's Little Theorem. It states that 3^(7-1) is congruent to 1 mod 7. So, 3^6 is congruent to 1 mod 7. We can write the exponent 100 as 6 * 16 + 4. Thus, 3^100 = (3^6)^16 * 3^4. Modulo 7, this becomes (1)^16 * 3^4 = 81. Dividing 81 by 7 gives 81 = 7 * 11 + 4. Therefore, the remainder is 4. Proof complete."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="START ADVANCED TEST 15"
            android:textSize="18sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>