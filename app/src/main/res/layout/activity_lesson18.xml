<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 18: Areas &amp; Advanced Theorems"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heron, Ceva, Menelaus, and Pick's Theorem"
            android:textSize="16sp"
            android:textColor="#5D4037"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Heron's Formula"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What if you know all three sides of a triangle, but you don't know the height? Heron of Alexandria gave us a magical formula to find the Area using ONLY the side lengths."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgHeron"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_heron" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec1Formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 1: Find the Semi-Perimeter (s)\ns = (a + b + c) / 2\n\nStep 2: Apply the Formula\nArea = √[ s × (s-a) × (s-b) × (s-c) ]"
            android:typeface="monospace"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:padding="20dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Ceva's Theorem"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A 'Cevian' is any line segment from a vertex to the opposite side. If three Cevians (AD, BE, CF) intersect at a SINGLE point P, Ceva's Theorem guarantees a perfect ratio. This works whether the point P is INSIDE or OUTSIDE the triangle!"
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgCevaInside"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_ceva_inside" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgCevaOutside"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_ceva_outside" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec2Formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE MAGICAL RATIO:\n(AF / FB) × (BD / DC) × (CE / EA) = 1"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#C8E6C9"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Menelaus's Theorem"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="While Ceva is about lines intersecting at a point, Menelaus is about a straight line cutting strictly ACROSS the triangle, intersecting two sides and the extension of the third side."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgMenelaus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_menelaus" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec3Formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If a line cuts AB at F, AC at E, and the extension of BC at D, the formula is identical to Ceva:\n\n(AF / FB) × (BD / DC) × (CE / EA) = 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:background="#FCE4EC"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec4Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Pick's Theorem"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec4Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is an incredible Olympiad shortcut! If you draw a polygon on a square grid so that all its vertices land perfectly on grid dots, you don't need complex geometry to find its area. You just COUNT the dots!"
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgPick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_pick" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec4Formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formula: Area = I + (B / 2) - 1\n\n• I = Number of dots strictly INSIDE the polygon.\n• B = Number of dots ON THE BOUNDARY (perimeter)."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#D32F2F"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvMasterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masterclass: Advanced Problems"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 1: The 13-14-15 Triangle"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb1Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: A triangle has side lengths 13, 14, and 15. Calculate its exact Area."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb1S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Calculate semi-perimeter (s).\ns = (13 + 14 + 15) / 2 = 21."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Apply Heron's formula.\nArea = √( 21 × 8 × 7 × 6 )"
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Break down into primes:\n21 = 3×7, 8 = 2³, 7 = 7, 6 = 2×3\nCombine: 2⁴ × 3² × 7²\nSquare root = 2² × 3 × 7 = 84."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The Area is 84."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 2: Ceva's Missing Ratio"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb2Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: In triangle ABC, Cevians meet at point P. We know: AF=2, FB=1, BD=3, DC=2, and EA=4. Find the length of CE."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb2S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Set up Ceva's formula.\n(AF/FB) × (BD/DC) × (CE/EA) = 1"
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Plug in the known values. Let CE = x.\n(2/1) × (3/2) × (x/4) = 1"
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Solve for x.\n3x / 4 = 1 \n3x = 4 \nx = 4/3."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The length of CE is 4/3."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest18"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="TAKE TEST 18"
            android:textStyle="bold"
            android:textSize="22sp"
            app:backgroundTint="#BBDEFB"
            android:textColor="#3E2723"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>