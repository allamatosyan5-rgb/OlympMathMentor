<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDialogStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Student's Submission"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvDialogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#212121"
        android:layout_marginBottom="12dp"
        android:background="#F5F5DC"
        android:padding="10dp"
        android:visibility="gone"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutDialogImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Evaluate:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#757575"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDialogGrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter grade (e.g., 10)"
        android:inputType="number"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSubmitGrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Grade"
        android:backgroundTint="#8D6E63"
        android:textColor="#FFFFFF"/>
</LinearLayout>