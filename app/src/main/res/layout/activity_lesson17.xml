<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 17: Centers &amp; Circles"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medians, Altitudes, Incenters, and Circle Angles"
            android:textSize="16sp"
            android:textColor="#5D4037"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnReadLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Read Lesson Aloud"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. The Centroid"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec1Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A MEDIAN is a line connecting a vertex to the midpoint of the opposite side. The three medians of a triangle always meet at a single magical point called the Centroid (G)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgCentroid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_centroid" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec1Rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE 2:1 RATIO RULE:\nThe Centroid divides every median into two segments in a 2:1 ratio, with the longer part being closer to the vertex. \nAG : GM = 2 : 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:background="#BBDEFB"
            android:padding="20dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSec2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. The Orthocenter"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSec2Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An ALTITUDE  is a perpendicular line dropped from a vertex to the opposite side. The three altitudes meet at the Orthocenter (H)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgOrthocenter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_orthocenter" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec2Trick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRICKY FACT:\nIf the triangle is Acute, 'H' is inside. If it is Right-angled, 'H' is exactly on the 90° vertex. If it is Obtuse, 'H' is OUTSIDE the triangle!"
            android:textColor="#212121"
            android:textSize="16sp"
            android:background="#FFCDD2"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec3Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Circumcenter &amp; Incenter"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Circum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="► CIRCUMCENTER (O): The intersection of the perpendicular bisectors of the sides. It is the center of the circle that passes through all 3 vertices (Circumcircle). \nRule: O is EQUIDISTANT from all vertices (OA = OB = OC = R)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Incenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="► INCENTER (I): The intersection of the angle bisectors. It is the center of the circle that fits perfectly INSIDE, touching all 3 sides (Incircle). \nRule: I is EQUIDISTANT from all sides (distance = r)."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec3Formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crucial Area Formula:\nArea = r × s \n(where 'r' is inradius, and 's' is the semi-perimeter: (a+b+c)/2 )"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:background="#C8E6C9"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSec4Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Angles in a Circle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSec4Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The relationship between Central Angles (vertex at the center) and Inscribed Angles (vertex on the circle's edge) is a favorite Olympiad trap."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgCircleAngles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:src="@drawable/img_circle_angles" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSec4Rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE DOUBLE ANGLE THEOREM:\nThe Central Angle (AOB) is always exactly TWICE the size of the Inscribed Angle (ACB) if they both stand on the same arc (AB).\n\nAOB = 2 × ACB"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:background="#E1BEE7"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvMasterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masterclass: Advanced Problems"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 1: The Median Length"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb1Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: In triangle ABC, median AM has a total length of 15cm. G is the centroid. What is the length of AG?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb1S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: We know the Centroid (G) divides the median AM in a 2:1 ratio."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: This means the whole median consists of 2 parts + 1 part = 3 parts total."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: Total length is 15. So 1 part = 15 / 3 = 5cm. This is the shorter segment (GM)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1S4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: AG is the longer segment (2 parts). \nAG = 2 × 5 = 10cm."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb1Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: AG = 10 cm."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvProb2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 2: Thales in the Circle"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProb2Q"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: AB is the diameter of a circle. Point C is on the circle. What is the exact measure of the inscribed angle ACB?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProb2S1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Look at the Central Angle. Since AB is a diameter, it forms a straight line. Therefore, the central angle AOB is exactly 180°."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: Use the Double Angle Theorem. The central angle (180°) is TWICE the inscribed angle (ACB) because they stand on the same arc (a semi-circle)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2S3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: So, ACB = 180° / 2 = 90°."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvProb2Ans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: It is a 90° angle. (This is known as Thales's Theorem for circles: An angle inscribed in a semicircle is always a right angle)."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest17"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="TAKE TEST 17"
            android:textStyle="bold"
            android:textSize="22sp"
            app:backgroundTint="#F8BBD0"
            android:textColor="#3E2723"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>