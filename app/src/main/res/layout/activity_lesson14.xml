<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson 14: Advanced GCD &amp; LCM"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extended Euclidean Algorithm, Bezout's Identity, and Divisor Functions"
            android:textSize="16sp"
            android:textColor="#5D4037"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textStyle="italic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Number of Divisors"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In Olympiads, you are rarely asked to simply list divisors. Instead, you are asked HOW MANY divisors a massive number has. Counting them manually is impossible. We use Prime Factorization."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE DIVISOR FORMULA (τ):"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 1: Write the number 'N' in its prime factored form:\nN = p^a × q^b × r^c ...\n(where p, q, r are primes and a, b, c are their powers).\n\nStep 2: Add 1 to every power and multiply them together:\nTotal Divisors = (a + 1) × (b + 1) × (c + 1) ..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:background="#C8E6C9"
            android:padding="20dp"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example: How many divisors does 120 have?\n120 = 2³ × 3¹ × 5¹.\nThe powers are 3, 1, and 1.\nFormula: (3+1) × (1+1) × (1+1) = 4 × 2 × 2 = 16 divisors."
            android:textColor="#212121"
            android:textSize="16sp"
            android:background="#E8E0C5"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3E2723"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Bezout's Identity"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bezout's Identity is a magical theorem in Number Theory. It states that for any two integers 'a' and 'b', their Greatest Common Divisor (GCD) can ALWAYS be written as a linear combination of 'a' and 'b'."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ax + by = GCD(a, b)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="#D32F2F"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here, 'x' and 'y' are integers (one of them will usually be negative). \n\nExample: Let a = 12, b = 15. The GCD is 3. \nCan we find x, y such that 12x + 15y = 3? \nYes! If x = -1 and y = 1, then 12(-1) + 15(1) = 3."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Linear Diophantine Equations"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An equation of the form ax + by = c, where you only want integer solutions, is called a Linear Diophantine Equation."
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE SOLVABILITY TEST:\nThe equation ax + by = c has integer solutions IF AND ONLY IF 'c' is perfectly divisible by GCD(a, b)."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:background="#BBDEFB"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example: Can you buy exactly $43 worth of items using only $6 and $9 coins? \nEquation: 6x + 9y = 43. \nGCD(6, 9) = 3. \nSince 43 is NOT divisible by 3, this is IMPOSSIBLE!"
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D7CCC8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. GCD &amp; LCM of Fractions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What if you need the LCM of fractions? For example, bells ringing every 3/4 of a minute and 5/6 of a minute. There are special formulas for this:"
            android:textColor="#212121"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• LCM of Fractions = LCM(Numerators) / GCD(Denominators)\n\n• GCD of Fractions = GCD(Numerators) / LCM(Denominators)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:background="#C8E6C9"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masterclass: Advanced Problems"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 1: The Gear Synchronization"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00695C"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: Two interlocking gears have 24 teeth and 36 teeth respectively. We mark the two teeth that are currently touching. How many FULL REVOLUTIONS must the smaller gear make before the exact same two marked teeth touch again?"
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: For the same teeth to touch again, the total number of teeth that pass the contact point must be a perfect multiple of BOTH 24 and 36."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: This means we need the Least Common Multiple (LCM) of 24 and 36."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: LCM(24, 36) = 72. This means 72 teeth must pass the contact point."
                android:textColor="#424242"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: The problem asks for the number of revolutions of the SMALLER gear (which has 24 teeth). \nRevolutions = 72 / 24 = 3."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The smaller gear makes 3 revolutions."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Problem 2: The Mysterious Pair"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question: The product of two numbers 'a' and 'b' is 300. Their GCD is 5. Find the sum of these two numbers (assuming neither number is equal to the GCD itself)."
                android:textColor="#212121"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: If GCD(a,b) = 5, then both numbers are multiples of 5. \nLet a = 5m and b = 5n, where 'm' and 'n' are coprime (their GCD is 1)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2: We know a × b = 300. \nSo, (5m) × (5n) = 300 \n25mn = 300 \nmn = 12."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3: We need pairs of integers (m, n) that multiply to 12 and are coprime. \nPairs for 12: (1, 12), (2, 6), (3, 4). \n(2, 6) is NOT coprime because they are both even. So we can only use (1, 12) or (3, 4)."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 4: If m=1, n=12, then a=5, b=60. But the problem said neither number is the GCD itself (so 'a' cannot be 5). \nWe must use m=3, n=4. \nSo a = 5×3 = 15, and b = 5×4 = 20."
                android:textColor="#424242"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer: The numbers are 15 and 20. Their sum is 35."
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTest14"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="TAKE TEST 14"
            android:textStyle="bold"
            android:textSize="22sp"
            app:backgroundTint="#FFCC80"
            android:textColor="#3E2723"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>