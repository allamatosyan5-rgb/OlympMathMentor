<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_beige">

    <LinearLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="20dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATCH FINISHED!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="40dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layoutMyAvatar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvMyAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="6dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#D7CCC8"
                        android:padding="16dp"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvMyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Me"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/tvMyScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#5D4037"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#757575"/>

            <LinearLayout
                android:id="@+id/layoutOppAvatar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvOppAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="6dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#E0E0E0"
                        android:padding="16dp"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvOppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opponent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/tvOppScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#5D4037"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvEarnedStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0 Stars"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="40dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMenu"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="BACK TO MENU"
            app:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieResult"
        android:layout_width="match_parent"
        android:layout_height="740dp"
        android:elevation="20dp"
        android:scaleType="fitCenter"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

</RelativeLayout>